VITE_SITE_URL=https://hellosherise.com
# Set to the exact public origin in production (no trailing slash).
# For local development this can be omitted; the request origin is used.
APP_ORIGIN=https://hellosherise.com

# MySQL database used by admin products/categories/inventory.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Local SQLite fallback for customer/account data in Node hosting.
SHERISE_DATABASE_PATH=data/sherise.sqlite

# Required for protected admin API cookies. Use a strong 32+ character secret.
ADMIN_SESSION_SECRET=replace-with-a-strong-32-character-secret

# Never prefix secrets with VITE_. Configure both to enable reset emails.
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Local tests only: write reset links into ignored data/dev-mail files.
AUTH_DEV_OUTBOX=false
PORT=3000

# Keep false until Test Mode and webhook delivery have been verified.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Separate random 32+ character secret; enter the same value in Razorpay Dashboard.
RAZORPAY_WEBHOOK_SECRET=

# Ekart server-only credentials. Account pricing must be confirmed in Shipping Settings.
EKART_CLIENT_ID=
EKART_USERNAME=
EKART_PASSWORD=
EKART_API_BASE_URL=https://app.elite.ekartlogistics.in
EKART_SHIPPING_ENABLED=false
# Operator-only approval for the stock-expiry maintenance command
COMMERCE_MAINTENANCE_APPROVED=false

# Temporary operator gate, only after explicit production migration approval
COMMERCE_MIGRATION_APPROVED=false

# Operator-only approval for queue processing / authenticated tracking synchronization
EKART_WORKER_APPROVED=false
