VITE_SITE_URL=https://sherise.example
# Set to the exact public origin in production (no trailing slash).
# For local development this can be omitted; the request origin is used.
# APP_ORIGIN=https://your-domain.example
SHERISE_DATABASE_PATH=data/sherise.sqlite
# Never prefix secrets with VITE_. Configure both to enable reset emails.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Local tests only: write reset links into ignored data/dev-mail files.
AUTH_DEV_OUTBOX=false
